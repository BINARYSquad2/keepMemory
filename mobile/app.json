{
  "expo": {
    "name": "KeepMemory",
    "slug": "keepmemory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keepmemory",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060609",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepmemory.app"
    },
    "android": {
      "package": "com.keepmemory.app",
      "adaptiveIcon": {
        "backgroundColor": "#060609",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060609"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фотографиям, чтобы собирать альбомы ваших дней."
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
